# Shopify app client ID from the Partner Dashboard. Public identifier, still required at startup.
SHOPIFY_API_KEY=your-shopify-api-key

# Shopify app client secret. Verifies OAuth callbacks and webhook HMAC signatures.
SHOPIFY_API_SECRET=your-shopify-api-secret

# Comma-separated Admin API scopes requested during install.
SCOPES=read_orders,read_customers

# Public base URL of this app. Shopify and Twilio both call back to it. No trailing path.
SHOPIFY_APP_URL=https://your-tunnel.example.com

# Admin API version used for GraphQL calls. Must be a version this app's Shopify library supports.
SHOPIFY_API_VERSION=2026-01

# HTTP port the Node server listens on.
PORT=3000

# Interface to bind. Use 0.0.0.0 in containers.
HOST=0.0.0.0

# development, test, or production. development allows the optional local admin bypass below.
NODE_ENV=development

# Prisma database URL. SQLite file is fine for local development. Use Postgres in production.
DATABASE_URL=file:./dev.db

# Twilio Account SID for the account that owns the sender number. Twilio SIDs start with AC. This placeholder is not a real account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio auth token. Verifies inbound webhook signatures and authorizes the API.
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# E.164 sender number, for example a Twilio number you control.
TWILIO_FROM_NUMBER=+15555550100

# Set to true only when Twilio Advanced Opt-Out is enabled on the number. The app still records STOP, but it will not send its own STOP or HELP reply.
TWILIO_ADVANCED_OPT_OUT=false

# development only. When true, the embedded UI can call the API without a Shopify session token.
ALLOW_DEV_ADMIN=false

# How often the send worker looks for due jobs, in milliseconds.
WORKER_POLL_MS=5000

# How often the stalled-order scan runs, in milliseconds.
STALLED_SCAN_MS=3600000

# Region used when a webhook phone number has no country code.
DEFAULT_PHONE_COUNTRY=US
